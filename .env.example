# ================================================================
#  CODÉO — variables d'environnement
#  Copie ce fichier en ".env.local" et remplis les valeurs.
#  NE JAMAIS committer .env.local (déjà ignoré par git).
# ================================================================

# Clé API Resend — pour l'envoi des emails du formulaire de contact.
# 1. Crée un compte GRATUIT sur https://resend.com AVEC l'email pscalessandro5@gmail.com
# 2. Menu "API Keys" > "Create API Key" > copie la clé (commence par "re_")
# 3. Colle-la ci-dessous.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# URL publique du site (utilisée pour le QR code, le sitemap, l'Open Graph).
# En local : http://localhost:3000  —  En prod : https://ton-domaine.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
